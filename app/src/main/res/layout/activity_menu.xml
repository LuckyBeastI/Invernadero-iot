<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true"
    tools:context=".MenuPrincipal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/azul_titulo"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Nombre Usuario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Menú"
            android:textColor="@color/negro"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnManipular"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/negro_boton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Manipular Circuito"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/btnAcciones"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/negro_boton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ver Acciones Realizadas"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/btnEstadisticas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/negro_boton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ver Estadísticas"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/negro_boton"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ver Perfil"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/btnCerrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/rojo_volver"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cerrar Sesión"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            app:cornerRadius="6dp" />

    </LinearLayout>
</ScrollView>
